# hpmaker 플랫폼 (가비아 Apache) 설정
DirectoryIndex index.html
Options -Indexes

# 설정·DB 구조 파일은 밖에서 열 수 없게 막습니다.
<FilesMatch "\.(sql|md|sample\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 로그인 토큰(Authorization)을 PHP 가 받을 수 있게 전달합니다.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# 응답 압축: 화면 파일과 API 결과를 gzip 으로 줄여 더 빨리 전송합니다.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# 화면 파일(css·js)과 상품 사진은 브라우저에 오래 저장해 다시 받지 않습니다.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
